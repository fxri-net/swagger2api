<%
const { utils, config, routes, modelTypes, route } = it;
const { _, pascalCase } = utils;
const dataContracts = config.modular ? _.map(modelTypes, "name") : [];
// 运行时枚举按值导入，其余纯类型走 import type；JS 产物的声明文件保持值导入形态
const valueContracts = config.modular
  ? config.toJS
    ? dataContracts
    : modelTypes.filter((item) => item.typeIdentifier === "enum" && !config.generateUnionEnums).map((item) => item.name)
  : [];
const typeContracts = config.toJS ? [] : dataContracts.filter((name) => !valueContracts.includes(name));
const dataContractsFile = config.fileNames?.dataContracts ?? "data-contracts";
const isModular = Boolean(config.modular && route);
// 分组模式由命名表提供名称空间，与模块类名同源
const moduleName = isModular ? (config.param?.moduleClassNames?.[route.moduleName] ?? pascalCase(route.moduleName)) : "";
%>
<% if (valueContracts.length) { %>
import { <%~ valueContracts.join(", ") %> } from "./<%~ dataContractsFile %>"
<% } %>
<% if (typeContracts.length) { %>
import type { <%~ typeContracts.join(", ") %> } from "./<%~ dataContractsFile %>"
<% } %>

<% if (isModular) { %>

export namespace <%~ moduleName %> {
<% for (const item of route.routes || []) { %>

  <%~ includeFile('./route-type.ejs', { ...it, route: item }) %>
<% } %>
}

<% } else { %>

<%
/* TODO: outOfModule, combined should be attributes of route, which will allow to avoid duplication of code */
%>

<% if (routes.outOfModule) { %>
 <% for (const { routes: outOfModuleRoutes = [] } of routes.outOfModule) { %>
   <% for (const route of outOfModuleRoutes) { %>
     <%~ includeFile('./route-type.ejs', { ...it, route }) %>
   <% } %>
 <% } %>
<% } %>

<% if (routes.combined) { %>
 <% for (const { routes: combinedRoutes = [], moduleName } of routes.combined) { %>
   export namespace <%~ pascalCase(moduleName) %> {
   <% for (const route of combinedRoutes) { %>
     <%~ includeFile('./route-type.ejs', { ...it, route }) %>
   <% } %>
   }

 <% } %>
<% } %>
<% } %>

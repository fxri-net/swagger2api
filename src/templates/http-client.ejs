<%
const { config } = it;
// 按客户端类型分发：axios 用本仓定制的不可枚举实现，其余走上游 fetch 模板
const httpClientType = config.httpClientType === config.constants.HTTP_CLIENT.AXIOS ? "axios" : "fetch";
%>
<% if (httpClientType === "axios") { %>
<%~ includeFile("./http-client-axios", it) %>
<% } else { %>
<%~ includeFile("@base/http-clients/fetch-http-client", it) %>
<% } %>

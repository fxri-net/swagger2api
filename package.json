{
  "name": "@fxri/swagger2api",
  "version": "1.2.15",
  "description": "基于 swagger-typescript-api，将 Swagger 文档自动转为 TypeScript 格式的 API 文件。",
  "license": "MIT",
  "author": {
    "name": "唐启云",
    "email": "tqy@fxri.net",
    "url": "https://fxri.net:444/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fxri-net/swagger2api.git"
  },
  "bugs": {
    "url": "https://github.com/fxri-net/swagger2api/issues"
  },
  "homepage": "https://fxri-net.github.io/swagger2api/",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "swagger2api": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "TRADEMARK.md",
    "NOTICE",
    "package.json"
  ],
  "scripts": {
    "dev": "pnpm build:debug && node ./dist/cli.js",
    "build": "cross-env NODE_ENV=production tsup",
    "build:debug": "cross-env NODE_ENV=development tsup --config tsup.dev.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint \"src/**/*.ts\" \"scripts/**/*.mjs\" --no-cache",
    "lint:fix": "eslint \"src/**/*.ts\" \"scripts/**/*.mjs\" --fix",
    "changeset": "node scripts/toolkit.mjs changelog",
    "changelog:version": "node scripts/toolkit.mjs changelog version",
    "sync:changelog-doc": "node scripts/toolkit.mjs changelog doc",
    "tasks": "node scripts/toolkit.mjs tasks",
    "tasks:archive": "node scripts/toolkit.mjs tasks archive",
    "verify": "node scripts/verify.mjs",
    "release": "pnpm build && pnpm publish",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "api": "pnpm dev --axios --responses -q -rpi 0 -err"
  },
  "keywords": [
    "swagger",
    "typescript",
    "api",
    "openapi",
    "fxri"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "pnpm@10.34.4",
  "dependencies": {
    "axios": "^1.21.0",
    "glob": "^14.0.3",
    "prompts": "^2.4.2",
    "swagger-typescript-api": "^13.13.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/prompts": "^2.4.9",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "cross-env": "^10.1.0",
    "esbuild-plugin-copy": "^2.1.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vitepress": "^1.6.4",
    "vitest": "^2.1.9"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "dompurify": "^3.4.17",
      "fast-uri": "^3.1.9",
      "follow-redirects": "^1.16.2",
      "brace-expansion@1": "^1.1.21",
      "brace-expansion@5": "^5.0.12",
      "esbuild-plugin-copy>esbuild": "^0.28.2",
      "bundle-require>esbuild": "^0.28.2",
      "tsup>esbuild": "^0.28.2",
      "vite>esbuild": "^0.25.0",
      "source-map-js": "^1.2.2"
    }
  }
}
